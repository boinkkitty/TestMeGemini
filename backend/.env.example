# Django
DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Database (SQLite is the local-development default)
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3
# For PostgreSQL deployments, use django.db.backends.postgresql and provide:
# DATABASE_USER=
# DATABASE_PASSWORD=
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_CONN_MAX_AGE=60

# Authentication cookies
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax
# JWT_COOKIE_DOMAIN=
# For a genuinely cross-site frontend, use SameSite=None together with secure
# HTTPS cookies for JWT, CSRF, and session cookies.

# Gemini chapter generation
GEMINI_API_KEY=replace-with-your-api-key
GEMINI_TIMEOUT_SECONDS=30
CHAPTER_UPLOAD_MAX_FILES=5
CHAPTER_UPLOAD_MAX_FILE_BYTES=10485760
CHAPTER_UPLOAD_MAX_TOTAL_BYTES=26214400
CHAPTER_UPLOAD_MAX_PDF_PAGES=80
CHAPTER_UPLOAD_MAX_TEXT_CHARS=120000

# API limits and throttles
CHAPTER_QUESTION_LIMIT_MAX=50
QUESTION_CHOICE_LIMIT_MAX=10
CHAPTER_LIST_LIMIT_MAX=100
ATTEMPT_LIST_LIMIT_MAX=100
DRF_CHAPTER_GENERATION_THROTTLE_RATE=5/hour
