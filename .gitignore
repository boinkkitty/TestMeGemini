# === Node.js (Next.js frontend/) ===
frontend/node_modules/
frontend/.next/
frontend/.env.local
frontend/.env*
frontend/yarn.lock


# === Python/Django (backend/) ===
backend/__pycache__/
backend/**/*.py[cod]
backend/**/*.sqlite3
backend/*.sqlite3
backend/db.sqlite3
backend/.env
backend/env/
backend/venv/
backend/.venv/
backend/.mypy_cache/
backend/.pytest_cache/
backend/.vscode/
backend/*.log
# Django migrations are source code and must be committed so every deployment
# builds the same schema. Only their generated bytecode is ignored above.
# Ignore all database files
*.sqlite3
*.db
*.db-journal

# === Docker ===
# docker-compose.override.yml is for local overrides, not committed
docker-compose.override.yml

# === OS/system files ===
.DS_Store
Thumbs.db

# === Git ===
*.swp
*.swo
*.orig

.idea/
.vercel
